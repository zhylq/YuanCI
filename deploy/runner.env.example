YUANCI_VERSION=latest
YUANCI_RUNNER_GRPC_ADDRESS=ci.example.com:9443
YUANCI_RUNNER_GRPC_SERVER_NAME=ci.example.com
YUANCI_RUNNER_NAME=docker-runner-1
YUANCI_RUNNER_CAPACITY=2
YUANCI_RUNNER_AVAILABLE_DISK_BYTES=10737418240
YUANCI_DOCKER_GID=998
YUANCI_RUNNER_ROOT_CA_PATH=/absolute/path/to/root-cert.pem
YUANCI_RUNNER_BOOTSTRAP_DIR=/absolute/path/to/writable/bootstrap-directory
