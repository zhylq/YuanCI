# Copy into .secrets/auth-preview.env and fill in every empty value.
# Use a fresh random hex database password (64 characters recommended), not the Quickstart password.
YUANCI_POSTGRES_PASSWORD=
YUANCI_PUBLIC_ORIGIN=https://ci.example.com
YUANCI_GITHUB_CLIENT_ID=
# Numeric ID from the GitHub users API, NOT your username or the App ID.
YUANCI_BOOTSTRAP_GITHUB_USER_ID=
# Absolute path; Windows example: D:/code/ai/YuanCI/.secrets/github-client-secret
YUANCI_GITHUB_CLIENT_SECRET_PATH=
YUANCI_AUTH_PREVIEW_PORT=8081
