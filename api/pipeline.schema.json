{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuanci.dev/schemas/pipeline/v1.json",
  "title": "YuanCI Pipeline v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "stages"],
  "properties": {
    "version": { "const": "v1" },
    "name": { "$ref": "#/$defs/name" },
    "environment": { "$ref": "#/$defs/environment" },
    "concurrency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["group"],
      "properties": {
        "group": { "type": "string", "minLength": 1 },
        "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
        "cancel_previous": { "type": "boolean", "default": false }
      }
    },
    "triggers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event"],
        "properties": {
          "event": { "enum": ["push", "pull_request", "tag", "manual", "cron", "api"] },
          "branches": { "type": "array", "items": { "type": "string" } },
          "paths": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/stage" }
    }
  },
  "$defs": {
    "name": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,62}$" },
    "environment": { "type": "object", "additionalProperties": { "type": "string" } },
    "stage": {
      "type": "object", "additionalProperties": false, "required": ["name", "jobs"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "depends_on": { "type": "array", "items": { "$ref": "#/$defs/name" }, "uniqueItems": true },
        "jobs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/job" } }
      }
    },
    "job": {
      "type": "object", "additionalProperties": false, "required": ["name", "steps"],
      "properties": {
        "name": { "$ref": "#/$defs/name" }, "image": { "type": "string" },
        "depends_on": { "type": "array", "items": { "$ref": "#/$defs/name" }, "uniqueItems": true },
        "timeout": { "type": "string" }, "retry": { "type": "integer", "minimum": 0, "maximum": 5 },
        "environment": { "$ref": "#/$defs/environment" },
        "secrets": { "type": "array", "items": { "$ref": "#/$defs/name" }, "uniqueItems": true },
        "matrix": { "type": "object", "additionalProperties": { "type": "array", "minItems": 1, "items": { "type": "string" } } },
        "runs_on": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "os": { "$ref": "#/$defs/runnerValue" },
            "architecture": { "$ref": "#/$defs/runnerValue" },
            "executor": { "$ref": "#/$defs/runnerValue" },
            "labels": {
              "type": "object", "maxProperties": 64,
              "propertyNames": { "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$" },
              "additionalProperties": { "type": "string", "maxLength": 256 }
            }
          }
        },
        "resources": {
          "type": "object", "additionalProperties": false,
          "properties": { "cpu": { "type": "string" }, "memory": { "type": "string" }, "disk": { "type": "string" }, "pids": { "type": "integer", "minimum": 1 }, "privileged": { "const": false } }
        },
        "services": { "type": "array", "items": { "$ref": "#/$defs/service" } },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } }
      }
    },
    "runnerValue": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,62}$" },
    "service": {
      "type": "object", "additionalProperties": false, "required": ["name", "image"],
      "properties": { "name": { "$ref": "#/$defs/name" }, "image": { "type": "string", "minLength": 1 }, "environment": { "$ref": "#/$defs/environment" } }
    },
    "step": {
      "type": "object", "additionalProperties": false, "required": ["name", "commands"],
      "properties": {
        "name": { "$ref": "#/$defs/name" }, "image": { "type": "string" },
        "commands": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "working_dir": { "type": "string" }, "environment": { "$ref": "#/$defs/environment" }, "timeout": { "type": "string" }
      }
    }
  }
}
